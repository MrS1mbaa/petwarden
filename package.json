{
  "name": "petwarden",
  "version": "1.0.0",
  "description": "PetWarden: an offline-first Android app for everyday pet care: daily tasks, health records, planner, documents and local reminders.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrS1mbaa/petwarden.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "main": "index.js",
  "dependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "drizzle-orm": "^0.45.3",
    "expo": "~57.0.31",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check": "node --experimental-strip-types scripts/check-theme.mts && node --experimental-strip-types scripts/check-database.mts && node --experimental-strip-types scripts/check-care.mts && node --experimental-strip-types scripts/check-health.mts && node --experimental-strip-types scripts/check-planner.mts && node --experimental-strip-types scripts/check-documents.mts && node --experimental-strip-types scripts/check-notifications.mts && node scripts/check-photo-transition.cjs && node scripts/check-local-notifications.cjs && node scripts/generate-licenses.cjs --check",
    "postinstall": "node scripts/setup-skia.cjs",
    "lint": "expo lint",
    "start:lan": "expo start --lan --port 8081",
    "licenses": "node scripts/generate-licenses.cjs && node scripts/generate-android-licenses.cjs"
  },
  "private": true
}
