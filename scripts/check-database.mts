import assert from 'node:assert/strict';
import { DatabaseSync } from 'node:sqlite';
import { mkdirSync, unlinkSync } from 'node:fs';
import { migration1 } from '../src/db/migrations/0001.ts';
import { petAge } from '../src/features/pets/age.ts';
import { maskTime, maskTimes, maskDate, swappedDate } from '../src/lib/dateInput.ts';
import { initialDraft, parseBirthDate, parseTime, parseWeight, validateDraft, PetValidationError } from '../src/features/pets/validation.ts';

assert.equal(parseBirthDate('29.02.2024', '2026-10-06'), '2024-02-29');
assert.equal(parseBirthDate(''), null);
for (const date of ['29.02.2025', '31.04.2024', '07.10.2026', '01.01.1800', '2024-01-01']) assert.throws(() => parseBirthDate(date, '2026-10-06'), PetValidationError);
assert.equal(maskDate('01132026'), '01.13.2026');
assert.equal(maskDate('01/13-2026x99'), '01.13.2026');
assert.equal(maskDate('1'), '1');
for (const [typed, shown] of [['0800', '08:00'], ['08:00', '08:00'], ['800', '08:00'], ['8:00', '08:00'], ['8:', '08'], ['1', '1'], ['14', '14'], ['143', '14:3'], ['1430', '14:30'], ['14305', '14:30'], ['08:', '08'], ['', '']]) assert.equal(maskTime(typed), shown, typed);
assert.equal(maskTimes('08002000'), '08:00, 20:00');
assert.equal(maskTimes('08:00, 8'), '08:00, 08');
assert.equal(maskTimes('08:00, 2'), '08:00, 2');
assert.equal(maskDate('0113'), '01.13');
assert.equal(swappedDate('01.13.2026'), '13.01.2026');
assert.equal(swappedDate('13.01.2026'), null);
assert.equal(swappedDate('05.06.2026'), null);
const ageOn = (born: string, on: string) => petAge(born, new Date(`${on}T12:00:00`));
assert.equal(ageOn('2026-01-13', '2026-10-24'), '9 mo');
assert.equal(ageOn('2025-05-30', '2026-10-24'), '1 yr 4 mo');
assert.equal(ageOn('2024-10-24', '2026-10-24'), '2 yrs');
assert.equal(ageOn('2026-10-10', '2026-10-24'), '2 wk');
assert.equal(ageOn('2026-10-22', '2026-10-24'), '2 days');
assert.equal(ageOn('2026-12-01', '2026-10-24'), null);
assert.equal(parseWeight('12,4'), 12.4);
assert.equal(parseWeight(''), null);
for (const weight of ['0', '-1', 'NaN', '1e2', '500,1', '12,4kg']) assert.throws(() => parseWeight(weight), PetValidationError);
assert.equal(parseTime('8:00'), '08:00');
for (const time of ['24:00', '12:60', '8', '-1:00']) assert.throws(() => parseTime(time), PetValidationError);
assert.throws(() => validateDraft(initialDraft), PetValidationError);
const draft = validateDraft({ ...initialDraft, name: " Đole O'Neal ", walksEnabled: false, walk: 'nevažno' });
assert.equal(draft.name, "Đole O'Neal");
assert.equal(draft.walk, null);

mkdirSync('.artifacts', { recursive: true });
const path = `.artifacts/phase2-check-${Date.now()}.db`;
let db = new DatabaseSync(path);
try {
  db.exec('PRAGMA foreign_keys=ON; BEGIN;'); db.exec(migration1); db.exec('COMMIT;');
  assert.equal(db.prepare('PRAGMA user_version').get()!.user_version, 1);
  assert.equal(db.prepare("SELECT COUNT(*) AS n FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'").get()!.n, 10);
  db.prepare('INSERT INTO pets(name,species,breed,created_at) VALUES(?,?,?,?)').run(draft.name, 'dog', 'Mešanac', '2026-10-06T12:00:00Z');
  db.prepare('INSERT INTO weights(pet_id,value_kg,date) VALUES(?,?,?)').run(1, 12.4, '2026-10-06');
  db.prepare('INSERT INTO care_tasks(pet_id,type,title,time,repeat_rule) VALUES(?,?,?,?,?)').run(1, 'meal', 'Jutarnji obrok', '08:00', 'daily');
  assert.throws(() => db.prepare('INSERT INTO weights(pet_id,value_kg,date) VALUES(?,?,?)').run(999, 12.4, '2026-10-06'));
  assert.throws(() => db.prepare('INSERT INTO weights(pet_id,value_kg,date) VALUES(?,?,?)').run(1, 0, '2026-10-06'));
  db.prepare('INSERT INTO task_logs(task_id,date,done_at) VALUES(?,?,?)').run(1, '2026-10-06', '2026-10-06T08:00:00Z');
  assert.throws(() => db.prepare('INSERT INTO task_logs(task_id,date,done_at) VALUES(?,?,?)').run(1, '2026-10-06', '2026-10-06T09:00:00Z'));
  db.exec('BEGIN;');
  db.prepare('INSERT INTO pets(name,species,breed,created_at) VALUES(?,?,?,?)').run('Polovičan profil', 'dog', '', '2026-10-06');
  assert.throws(() => db.prepare('INSERT INTO weights(pet_id,value_kg,date) VALUES(?,?,?)').run(2, -1, '2026-10-06'));
  db.exec('ROLLBACK;');
  assert.equal(db.prepare('SELECT COUNT(*) AS n FROM pets').get()!.n, 1);
  db.close(); db = new DatabaseSync(path);
  assert.equal(db.prepare('SELECT name FROM pets WHERE id=1').get()!.name, draft.name);
  assert.equal(db.prepare('SELECT value_kg FROM weights WHERE pet_id=1').get()!.value_kg, 12.4);
  db.exec('PRAGMA foreign_keys=ON; DELETE FROM pets WHERE id=1;');
  assert.equal(db.prepare('SELECT COUNT(*) AS n FROM task_logs').get()!.n, 0);
  assert.equal(db.prepare('SELECT COUNT(*) AS n FROM weights').get()!.n, 0);
} finally { db.close(); unlinkSync(path); }
console.log('PASS: validacija, migracija svih tabela, FK/unique/check, rollback, reopen i cascade.');
