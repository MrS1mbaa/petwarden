import assert from 'node:assert/strict';
import { chartGeometry, nearestPoint } from '../src/features/health/chart.ts';
import { DatabaseSync } from 'node:sqlite';
import { migration1 } from '../src/db/migrations/0001.ts';
import { migration2 } from '../src/db/migrations/0002.ts';
import { migration3 } from '../src/db/migrations/0003.ts';
import { breedSuggestions } from '../src/features/pets/breeds.ts';
import { buildHealthPlan, limitReminderPlan } from '../src/notifications/healthPlan.ts';
import { reconcilePlan, type Reminder } from '../src/notifications/plan.ts';
import { validateWeight, validateVaccine, validateVisit, validateMedication, medicationTimes, medicationStatus, vaccineStatus, dateInput } from '../src/features/health/model.ts';
assert.deepEqual(validateWeight({ value: '12,45', date: '29.02.2024' }, '2026-10-06'), { valueKg: 12.45, date: '2024-02-29' });
assert.throws(() => validateWeight({ value: '0', date: '06.10.2026' }));
assert.throws(() => validateWeight({ value: '12', date: '07.10.2026' }, '2026-10-06'));
assert.throws(() => validateWeight({ value: '12', date: '29.02.2025' }));
assert.equal(dateInput('2024-02-29'), '29.02.2024');
assert.throws(() => validateVaccine({ name: 'Vakcina', givenAt: '', nextDueAt: '', notes: '' }));
assert.throws(() => validateVaccine({ name: 'Vakcina', givenAt: '05.10.2026', nextDueAt: '04.10.2026', notes: '' }, '2026-10-06'));
assert.equal(validateVisit({ date: '12.10.2026', clinic: ' Ambulanta ', reason: ' Kontrola ', notes: '' }).reason, 'Kontrola');
const medication = validateMedication({ name: ' Terapija ', dose: 'Po uputstvu veterinara', times: '18:00, 8:00, 08:00', startDate: '06.10.2026', endDate: '12.10.2026' });
assert.deepEqual(medicationTimes(medication.schedule), ['08:00', '18:00']);
assert.throws(() => validateMedication({ name: 'Lek', dose: '1', times: '24:00', startDate: '06.10.2026', endDate: '' }));
assert.throws(() => validateMedication({ name: 'Lek', dose: '1', times: '08:00', startDate: '06.10.2026', endDate: '05.10.2026' }));
assert.deepEqual(medicationTimes('bad JSON'), []);
assert.equal(medicationStatus(medication, '2026-10-07'), 'active');
assert.equal(medicationStatus(medication, '2026-10-13'), 'ended');
assert.equal(medicationStatus(medication, '2026-10-05'), 'planned');
assert.equal(vaccineStatus({ givenAt: null, nextDueAt: '2026-10-06' }, '2026-10-06'), 'due');
assert.equal(vaccineStatus({ givenAt: '2026-01-01', nextDueAt: '2026-10-05' }, '2026-10-06'), 'overdue');
const chart = chartGeometry([{ id: 1, date: '2026-10-01', valueKg: 12 }, { id: 2, date: '2026-10-02', valueKg: 12.1 }, { id: 3, date: '2026-10-06', valueKg: 12.4 }, { id: 4, date: '2026-10-02', valueKg: 12.2 }], 300, 180, 20, 30);
assert.deepEqual(chart.points.map(point => point.id), [1, 4, 3]);
assert.equal(chart.points[1].x, 72); // One fifth of the actual date range.
assert.equal(nearestPoint(chart.points, 75), 1);
assert.equal(nearestPoint(chart.points, -100), 0);
assert.equal(nearestPoint(chart.points, 1000), 2);
assert.ok(chart.points.every(point => Number.isFinite(point.x) && Number.isFinite(point.y)));
assert.equal(chartGeometry([{ id: 1, date: '2026-10-01', valueKg: 12 }], 300, 180, 20, 30).points[0].x, 150);
assert.equal(chartGeometry([], 300, 180, 20, 30).path, '');
assert.equal(chartGeometry([{ id: 1, date: '2026-10-01', valueKg: 12 }], 0, 180, 20, 30).points.length, 0);
const db = new DatabaseSync(':memory:');
db.exec('PRAGMA foreign_keys = ON');
db.exec(migration1);
db.prepare("INSERT INTO pets (name,species,breed,created_at) VALUES ('Bubi','dog','', '2026-10-06')").run();
db.exec(migration2);
assert.equal(db.prepare('PRAGMA user_version').get()!.user_version, 2);
assert.equal(db.prepare('SELECT name FROM pets WHERE id = 1').get()!.name, 'Bubi');
db.prepare("INSERT INTO pet_health_notes (pet_id,allergies,notes) VALUES (1,'Polen','Beleška')").run();
assert.throws(() => db.prepare("INSERT INTO pet_health_notes (pet_id) VALUES (999)").run());
assert.throws(() => db.prepare("UPDATE pet_health_notes SET allergies = ? WHERE pet_id = 1").run('x'.repeat(1001)));
db.prepare('DELETE FROM pets WHERE id = 1').run();
assert.equal(db.prepare('SELECT count(*) AS n FROM pet_health_notes').get()!.n, 0);
db.close();
// Migration 3: widen species without losing pets or their records (connection runs with foreign keys OFF).
const m3 = new DatabaseSync(':memory:');
m3.exec(migration1 + migration2);
m3.prepare("INSERT INTO pets (name,species,breed,created_at) VALUES ('Bubi','dog','Beagle','2026-10-06')").run();
m3.prepare("INSERT INTO weights (pet_id,value_kg,date) VALUES (1,12,'2026-10-06')").run();
assert.throws(() => m3.prepare("INSERT INTO pets (name,species,breed,created_at) VALUES ('Zeka','rabbit','', '2026-10-06')").run());
m3.exec('PRAGMA foreign_keys = OFF'); m3.exec(migration3); m3.exec('PRAGMA foreign_keys = ON');
assert.equal(m3.prepare('PRAGMA user_version').get()!.user_version, 3);
assert.equal(m3.prepare('SELECT breed FROM pets WHERE id = 1').get()!.breed, 'Beagle');
assert.equal(m3.prepare('SELECT count(*) AS n FROM weights').get()!.n, 1);
m3.prepare("INSERT INTO pets (name,species,breed,created_at) VALUES ('Zeka','rabbit','', '2026-10-06')").run();
assert.throws(() => m3.prepare("INSERT INTO pets (name,species,breed,created_at) VALUES ('X','dragon','', '2026-10-06')").run());
m3.prepare('DELETE FROM pets WHERE id = 1').run();
assert.equal(m3.prepare('SELECT count(*) AS n FROM weights').get()!.n, 0);
m3.close();
assert.ok(breedSuggestions('cat', '').includes('Maine Coon') && !breedSuggestions('cat', '').includes('Beagle'));
assert.deepEqual(breedSuggestions('dog', 'corgi'), ['Pembroke Welsh Corgi']);
assert.deepEqual(breedSuggestions('other', ''), []);
const now = new Date('2026-10-06T10:00:00').getTime();
const source = { vaccines: [{ id: 1, name: 'Vakcina', date: '2026-10-07', petName: 'Bubi' }], visits: [{ id: 1, name: 'Kontrola', date: '2026-10-06', petName: 'Bubi' }], medications: [{ medication: { id: 1, name: 'Terapija', dose: 'Po uputstvu', schedule: JSON.stringify({ times: ['08:00', '18:00'] }), startDate: '2026-10-06', endDate: '2026-10-07' }, petName: 'Bubi' }] };
const boundedHealth = buildHealthPlan(source, now);
assert.equal(boundedHealth.plan.length, 4); // Past visit and morning dose aren't scheduled.
assert.equal(boundedHealth.renewBy, null);
assert.ok(boundedHealth.plan.every(item => item.trigger.kind === 'date' && item.trigger.timestamp > now && item.url === '/health'));
const doses = boundedHealth.plan.filter(item => item.id.includes('medication'));
assert.equal(doses.length, 3);
assert.ok(doses.every(item => item.trigger.kind === 'date' && new Date(item.trigger.timestamp).getDate() <= 7));
const longHealth = buildHealthPlan({ ...source, medications: [{ ...source.medications[0], medication: { ...source.medications[0].medication, endDate: '2027-01-01' } }] }, now);
assert.equal(longHealth.renewBy, '2026-11-05');
const ongoing = buildHealthPlan({ vaccines: [], visits: [], medications: [{ ...source.medications[0], medication: { ...source.medications[0].medication, endDate: null } }] }, now);
assert.equal(ongoing.plan.length, 2);
assert.ok(ongoing.plan.every(item => item.trigger.kind === 'daily'));
const limited = limitReminderPlan(boundedHealth.plan, 2, null);
assert.equal(limited.plan.length, 2);
assert.equal(limited.limited, true);
assert.ok(limited.renewBy);
const pending = new Map<string, string | null>([['other.app', null]]);
const scheduled: Reminder[] = [];
const scheduler = { list: async () => [...pending].map(([id, fingerprint]) => ({ id, fingerprint })), cancel: async (id: string) => { pending.delete(id); }, schedule: async (item: Reminder) => { scheduled.push(item); pending.set(item.id, item.fingerprint); } };
await reconcilePlan(scheduler, boundedHealth.plan, now);
await reconcilePlan(scheduler, boundedHealth.plan, now);
assert.equal(scheduled.length, 4);
await reconcilePlan(scheduler, [], now);
assert.deepEqual([...pending.keys()], ['other.app']);
console.log('PASS: health dates, weight, vaccine chronology, medication schedule, chart geometry and status boundaries.');
